{
  "name": "stash-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Bitbucket Server (Stash) API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "stash-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"if (process.platform !== 'win32') require('child_process').execSync('chmod +x dist/index.js')\"",
    "postinstall": "node -e \"const fs=require('fs'); if (process.platform !== 'win32' && fs.existsSync('dist/index.js')) require('child_process').execSync('chmod +x dist/index.js')\"",
    "start": "node dist/index.js",
    "dev": "tsc -w",
    "dev:server": "npm run build && npx @modelcontextprotocol/inspector -e DEBUG=true node dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write 'src/**/*.ts'",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.1",
    "axios": "^1.6.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Timothy Schwarz",
  "repository": {
    "type": "git",
    "url": "https://github.com/schwarztim/stash-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/schwarztim/stash-mcp/issues"
  },
  "homepage": "https://github.com/schwarztim/stash-mcp#readme",
  "keywords": [
    "mcp",
    "bitbucket",
    "stash",
    "bitbucket-server",
    "bitbucket-data-center"
  ]
}
